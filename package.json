{
  "name": "domaxing",
  "productName": "Domaxing",
  "version": "1.0.0",
  "description": "A calm, local-first to-do app with a proactive AI planner.",
  "author": "YanaAnnt",
  "homepage": "https://yanaannt.github.io/domaxing/",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/gen-icons.mjs",
    "desktop": "node scripts/build-desktop.mjs --dir && electron . --data-dir=.desktop/data",
    "desktop:build": "node scripts/build-desktop.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@supabase/supabase-js": "^2.119.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.74.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "electron": "^45.3.4",
    "electron-builder": "^26.18.0",
    "ical.js": "^2.2.1",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5",
    "typescript": "5.8",
    "vitest": "^5.1.1",
    "web-push": "^4.0.0"
  },
  "build": {
    "appId": "com.yanaannt.domaxing",
    "productName": "Domaxing",
    "copyright": "Copyright © 2026 YanaAnnt",
    "directories": {
      "output": "dist-desktop",
      "buildResources": "public/icons"
    },
    "files": [
      "electron/**",
      "dist-web/**",
      "public/icons/icon-512.png",
      "package.json",
      "!**/node_modules/**"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icons/icon-512.png",
      "artifactName": "Domaxing-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Domaxing"
    },
    "electronLanguages": [
      "en-US",
      "he"
    ],
    "compression": "maximum"
  }
}
